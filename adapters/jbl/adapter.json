{
  "apiVersion": 1,
  "id": "jbl",
  "priority": 1000,
  "match": {
    "ble": true
  },
  "legacy": {
    "bridge": "jbl-bridge",
    "args": [
      "bleAddress",
      "modelId"
    ],
    "controls": {
      "noise.mode": {
        "type": "enum",
        "field": "mode",
        "choicesField": "available",
        "choices": [
          "off",
          "anc",
          "ambient",
          "talkthru"
        ],
        "command": "set"
      },
      "wear.detected": {
        "type": "boolean",
        "field": "worn",
        "readOnly": true
      }
    }
  },
  "status": "active",
  "entry": "protocol.py",
  "modelTransportFields": [
    "writeHandle",
    "notifyHandle"
  ],
  "transport": {
    "kind": "ble-gatt",
    "addressField": "bleAddress",
    "addressType": "random",
    "writeHandle": "0x0010",
    "notifyHandle": "0x000c",
    "discoveryTimeout": 15000,
    "registerTimeout": 5000,
    "allowUnconfirmedSubscription": true
  },
  "supportCache": "fast-pair-model",
  "referenceModels": {
    "JBL TUNE230NC TWS": {
      "match": {
        "name": "JBL TUNE230NC TWS"
      },
      "parameters": {}
    },
    "JBL Wave Buds 2": {
      "match": {
        "modelId": "ea59a0"
      },
      "parameters": {},
      "transport": {
        "writeHandle": "0xa202",
        "notifyHandle": "0xa205"
      }
    }
  }
}
